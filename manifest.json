{
    "manifest_version":3,
    "name":"LeetBuddy Extension",
    "icons":{
        "32":"logo.png"
    },
    "version":"1.0.1",
    "permissions":["activeTab","scripting","storage"],
    "action":{
        "default_popup":"popup.html",
        "default_icon":"logo.png"
    },
    "content_scripts":[
        {
        "matches":["<all_urls>"],
        "js":["content.js"]
        }
    ],
    "background":{
        "service_worker":"background.js"
    },
    "options_page":"option.html",
    "host_permissions":["<all_urls>"]
}